// CONTRATO DE DADOS do sistema financeiro pessoal.
// Convenções:
// - Valores em dinheiro: Decimal(14,2), em reais.
// - Transacao.valor é SEMPRE positivo; o sentido vem de Transacao.tipo (RECEITA entra, DESPESA sai).
// - Conta.saldo de um CARTAO é o valor em aberto da fatura (dívida, positivo).
// - Patrimônio = soma dos saldos das contas que não são CARTAO + soma de Investimento.saldo - soma dos saldos dos CARTAO.
// - origem OPEN_FINANCE: registro trazido pela Pluggy (Open Finance); é atualizado a cada sincronização.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

// Perfil único: o titular das finanças (e quem ele convidar) vê e altera tudo.
enum Perfil {
  TITULAR
  LEITOR // só consulta
}

enum Origem {
  MANUAL
  OPEN_FINANCE
}

enum TipoConta {
  CORRENTE
  POUPANCA
  CARTEIRA // dinheiro em espécie
  CARTAO // cartão de crédito
  INVESTIMENTO // conta em corretora (saldo parado na conta)
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

// ABERTA: ainda recebe compras. FECHADA: fechou e aguarda pagamento. PAGA. ATRASADA: venceu sem pagamento.
enum StatusFatura {
  ABERTA
  FECHADA
  PAGA
  ATRASADA
}

enum TipoInvestimento {
  RENDA_FIXA
  FUNDO
  ACAO
  FII
  ETF
  PREVIDENCIA
  CRIPTO
  OUTRO
}

enum TipoMovimentoInvestimento {
  APLICACAO
  RESGATE
  RENDIMENTO
  IMPOSTO
}

// ATUALIZADA: dados em dia. ATUALIZANDO: a instituição ainda está respondendo.
// ERRO_LOGIN: o banco pediu novo consentimento/senha. ERRO: outra falha (ver campo erro).
enum StatusConexao {
  ATUALIZADA
  ATUALIZANDO
  ERRO_LOGIN
  ERRO
}

// ---------- Pessoas ----------

model Usuario {
  id                 Int      @id @default(autoincrement())
  nome               String
  email              String   @unique
  senhaHash          String
  // Verificação em duas etapas (código de aplicativo autenticador).
  totpAtivo          Boolean  @default(false)
  totpSegredoCifrado String? // segredo base32 cifrado (lib/cripto)
  totpRecuperacao    String? // JSON com os hashes sha256 dos códigos de recuperação ainda não usados
  // Usuário LEITOR: só enxerga este perfil financeiro (null = todos).
  perfilFinanceiroId Int?
  perfil             Perfil   @default(TITULAR)
  ativo              Boolean  @default(true)
  cpf                String?
  telefone           String?
  foto               String? // endereço http(s) ou data URL (imagem reduzida enviada pelo usuário)
  criadoEm           DateTime @default(now())
}

// ---------- Open Finance (Pluggy) ----------

// Uma conexão = um "item" da Pluggy = o consentimento do usuário em uma instituição.
model ConexaoBancaria {
  id                  Int           @id @default(autoincrement())
  perfilId            Int           @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  pluggyItemId        String        @unique
  instituicao         String // nome do banco/corretora
  instituicaoLogo     String? // endereço da imagem
  instituicaoCor      String? // hex com #, ex.: "#820AD1"
  status              StatusConexao @default(ATUALIZANDO)
  erro                String? // mensagem da última falha
  ultimaSincronizacao DateTime?
  criadoEm            DateTime      @default(now())

  contas        Conta[]
  investimentos Investimento[]

  @@index([perfilId])
}

// ---------- Contas, cartões e lançamentos ----------

model Conta {
  id               Int       @id @default(autoincrement())
  perfilId         Int       @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  nome             String
  tipo             TipoConta
  instituicao      String?
  numero           String? // conta/agência ou final do cartão
  saldo            Decimal   @default(0) @db.Decimal(14, 2)
  cor              String    @default("#2563eb")
  ativo            Boolean   @default(true)
  // Só para CARTAO:
  bandeira         String?
  limite           Decimal?  @db.Decimal(14, 2)
  limiteDisponivel Decimal?  @db.Decimal(14, 2)
  diaFechamento    Int?
  diaVencimento    Int?

  origem          Origem           @default(MANUAL)
  conexaoId       Int?
  conexao         ConexaoBancaria? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  pluggyAccountId String?          @unique
  criadoEm        DateTime         @default(now())

  transacoes Transacao[]
  faturas    Fatura[]

  @@index([tipo])
  @@index([perfilId])
}

model Categoria {
  id       Int           @id @default(autoincrement())
  perfilId Int           @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  nome     String
  tipo     TipoTransacao
  cor      String        @default("#64748b")

  transacoes Transacao[]
  orcamento  Orcamento?

  @@index([perfilId, nome, tipo])
  @@index([perfilId])
}

model Transacao {
  id            Int           @id @default(autoincrement())
  perfilId      Int           @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  contaId       Int
  conta         Conta         @relation(fields: [contaId], references: [id], onDelete: Cascade)
  data          DateTime      @db.Date
  descricao     String
  valor         Decimal       @db.Decimal(14, 2) // sempre positivo
  tipo          TipoTransacao
  // true = movimento entre contas próprias ou pagamento de fatura: não entra em receitas/despesas dos relatórios.
  transferencia Boolean       @default(false)
  // Crédito de provento na conta da corretora que já virou rendimento do ativo: fica fora da lista de lançamentos
  // (aparece em Carteira > Proventos) e, por ser também transferência, fora das receitas.
  provento      Boolean       @default(false)
  pendente      Boolean       @default(false)
  categoriaId   Int?
  categoria     Categoria?    @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  faturaId      Int?
  fatura        Fatura?       @relation(fields: [faturaId], references: [id], onDelete: SetNull)
  parcela       Int? // número da parcela (1, 2, ...)
  totalParcelas Int?
  observacao    String?

  origem              Origem   @default(MANUAL)
  pluggyTransactionId String?  @unique
  // Lançamento que veio de um arquivo (CSV, OFX, PDF): impede importar o mesmo duas vezes. O registro continua MANUAL.
  chaveImportacao     String?
  importacaoId        Int? // Importacao.id do arquivo que trouxe este registro (histórico: ver, editar e remover)
  criadoEm            DateTime @default(now())

  @@index([contaId, data])
  @@index([data])
  @@index([categoriaId, data])
  @@index([faturaId])
  @@index([chaveImportacao])
  @@index([perfilId])
  @@index([importacaoId])
}

// Fatura de um cartão de crédito (Conta do tipo CARTAO). Uma por vencimento.
model Fatura {
  id         Int          @id @default(autoincrement())
  perfilId   Int          @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  contaId    Int
  conta      Conta        @relation(fields: [contaId], references: [id], onDelete: Cascade)
  vencimento DateTime     @db.Date
  fechamento DateTime?    @db.Date
  total      Decimal      @default(0) @db.Decimal(14, 2)
  minimo     Decimal?     @db.Decimal(14, 2)
  status     StatusFatura @default(ABERTA)
  pagaEm     DateTime?    @db.Date

  origem       Origem   @default(MANUAL)
  pluggyBillId String?  @unique
  criadoEm     DateTime @default(now())

  transacoes Transacao[]

  @@unique([contaId, vencimento])
  @@index([perfilId])
}

// ---------- Investimentos ----------

model Investimento {
  id            Int              @id @default(autoincrement())
  perfilId      Int              @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  nome          String
  codigo        String? // ticker ou código do ativo
  tipo          TipoInvestimento
  subtipo       String? // ex.: CDB, LCI, Tesouro Selic
  instituicao   String?
  emissor       String?
  valorAplicado Decimal          @default(0) @db.Decimal(14, 2)
  saldo         Decimal          @default(0) @db.Decimal(14, 2) // posição bruta atual
  saldoLiquido  Decimal?         @db.Decimal(14, 2)
  quantidade    Decimal?         @db.Decimal(20, 8)
  taxa          String? // texto livre, ex.: "110% do CDI", "IPCA + 6,2%"
  vencimento    DateTime?        @db.Date
  dataPosicao   DateTime         @default(now())
  ativo         Boolean          @default(true)

  origem             Origem           @default(MANUAL)
  conexaoId          Int?
  conexao            ConexaoBancaria? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  pluggyInvestmentId String?          @unique
  importacaoId       Int? // Importacao.id da planilha que CRIOU este ativo (null: cadastrado à mão ou só atualizado)
  cotadoEm           DateTime? // última vez em que o saldo foi atualizado pela cotação
  estimadoEm         DateTime? // última vez em que o saldo foi estimado pela taxa (renda fixa)
  criadoEm           DateTime         @default(now())

  movimentos MovimentoInvestimento[]

  @@index([tipo])
  @@index([perfilId])
}

model MovimentoInvestimento {
  id              Int                       @id @default(autoincrement())
  perfilId        Int                       @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  investimentoId  Int
  investimento    Investimento              @relation(fields: [investimentoId], references: [id], onDelete: Cascade)
  data            DateTime                  @db.Date
  tipo            TipoMovimentoInvestimento
  valor           Decimal                   @db.Decimal(14, 2) // sempre positivo
  quantidade      Decimal?                  @db.Decimal(20, 8)
  descricao       String?
  pluggyId        String?                   @unique
  chaveImportacao String? // movimento que veio da planilha da B3
  importacaoId    Int? // Importacao.id do arquivo que trouxe este registro (histórico: ver, editar e remover)
  criadoEm        DateTime                  @default(now())

  @@index([investimentoId, data])
  @@index([chaveImportacao])
  @@index([perfilId])
  @@index([importacaoId])
}

// Fotografia diária do patrimônio (uma por dia), para o gráfico de evolução.
model PosicaoPatrimonio {
  id            Int      @id @default(autoincrement())
  perfilId      Int      @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  data          DateTime @db.Date
  contas        Decimal  @db.Decimal(14, 2) // soma das contas que não são cartão
  investimentos Decimal  @db.Decimal(14, 2)
  cartoes       Decimal  @db.Decimal(14, 2) // dívida somada dos cartões (positivo)

  @@index([perfilId])
  @@index([perfilId, data])
}

// ---------- Importação de arquivos ----------

// Histórico do que foi importado de arquivo (fatura, extrato ou planilha da B3).
model Importacao {
  id         Int      @id @default(autoincrement())
  perfilId   Int      @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  criadoEm   DateTime @default(now())
  arquivo    String // nome do arquivo enviado
  tipo       String // FATURA, EXTRATO ou B3
  banco      String? // banco detectado (ou "B3")
  referencia String? // FATURA: vencimento AAAA-MM-DD; EXTRATO e B3: período
  contaId    Int? // sem relação: o histórico sobrevive à exclusão da conta
  contaNome  String?
  novos      Int // registros gravados
  repetidos  Int // registros que já existiam e foram ignorados
  total      Decimal? @db.Decimal(14, 2)

  @@index([criadoEm])
  @@index([perfilId])
}

// ---------- Planejamento ----------

// Limite mensal de gasto de uma categoria de DESPESA.
model Orcamento {
  id          Int       @id @default(autoincrement())
  perfilId    Int       @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  categoriaId Int       @unique
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  limite      Decimal   @db.Decimal(14, 2)

  @@index([perfilId])
}

model Meta {
  id             Int       @id @default(autoincrement())
  // Meta ligada: o valor guardado acompanha o saldo desta conta ou deste investimento.
  contaId        Int?
  investimentoId Int?
  perfilId       Int       @default(1) // perfil financeiro dono do registro (PerfilFinanceiro.id)
  nome           String
  valorAlvo      Decimal   @db.Decimal(14, 2)
  valorAtual     Decimal   @default(0) @db.Decimal(14, 2)
  prazo          DateTime? @db.Date
  cor            String    @default("#2563eb")
  concluida      Boolean   @default(false)
  criadoEm       DateTime  @default(now())

  @@index([perfilId])
}

// ---------- Sistema ----------

// Um registro por atividade na plataforma. Visível só para o TITULAR.
// Não guarda corpo de requisição nem senha. Registros com mais de 90 dias são apagados.
model LogAtividade {
  id          Int      @id @default(autoincrement())
  criadoEm    DateTime @default(now())
  usuarioId   Int? // sem relação: o log sobrevive à exclusão do usuário
  usuarioNome String?
  perfil      String? // perfil no momento: TITULAR
  tipo        String // LOGIN, FALHA_LOGIN, SAIDA, TELA, CONSULTA, CRIACAO, ALTERACAO, EXCLUSAO
  modulo      String // ex.: contas, transacoes, investimentos, sessao
  descricao   String // frase curta em português
  metodo      String? // GET, POST, PUT, DELETE
  caminho     String? // caminho da API ou da tela, sem query string
  status      Int? // código HTTP da resposta
  duracaoMs   Int?
  ip          String?
  navegador   String?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@index([tipo, criadoEm])
}

// ===== Perfis financeiros =====

// Cada perfil ("Pessoal", "Empresa", "Casal") tem as próprias contas, cartões, faturas, investimentos,
// categorias, orçamentos e metas. O mesmo login troca de perfil na tela. Os registros apontam para o perfil
// pela coluna perfilId (sem chave estrangeira, para o banco que já existe ganhar a coluna sem migração manual);
// o filtro por perfil é aplicado em lib/prisma.ts.
model PerfilFinanceiro {
  id       Int      @id @default(autoincrement())
  nome     String
  cor      String   @default("#2563eb")
  criadoEm DateTime @default(now())
}

// ===== Índices de referência (Selic, IPCA, Ibovespa, IFIX) =====

// Cada ponto é o nível acumulado do índice no dia: o retorno entre duas datas é a razão entre os níveis.
model IndicePonto {
  indice String
  data   DateTime @db.Date
  valor  Float

  @@id([indice, data])
}

// Fechamento diário de cada ativo negociado em bolsa (histórico para a rentabilidade da carteira).
model PrecoAtivo {
  codigo String
  data   DateTime @db.Date
  valor  Float

  @@id([codigo, data])
}

// ===== Regras, agenda, alvo e divisões (todos por perfil financeiro) =====

// Regra de categoria: lançamento cuja descrição contém o trecho recebe a categoria.
model RegraCategoria {
  id          Int      @id @default(autoincrement())
  perfilId    Int      @default(1)
  trecho      String // comparado sem acento e sem diferenciar maiúsculas
  categoriaId Int
  criadoEm    DateTime @default(now())

  @@index([perfilId])
}

// Conta fixa: algo que se repete todo mês (aluguel, salário, mensalidade).
model ContaFixa {
  id          Int           @id @default(autoincrement())
  perfilId    Int           @default(1)
  descricao   String
  tipo        TipoTransacao // DESPESA = a pagar; RECEITA = a receber
  valor       Decimal       @db.Decimal(14, 2)
  diaDoMes    Int // 1 a 31 (em mês curto vale o último dia)
  categoriaId Int?
  contaId     Int?
  ativa       Boolean       @default(true)
  criadoEm    DateTime      @default(now())

  @@index([perfilId])
}

// Marca de "paga" (ou "recebida") de uma conta fixa em um mês.
model PagamentoContaFixa {
  id          Int      @id @default(autoincrement())
  perfilId    Int      @default(1)
  contaFixaId Int
  mes         String // 'AAAA-MM'
  pagoEm      DateTime @default(now())

  @@index([perfilId])
  @@index([contaFixaId, mes])
}

// Percentual desejado de cada classe da carteira (RENDA_VARIAVEL, RENDA_FIXA, FUNDOS, OUTROS).
model AlocacaoAlvo {
  id         Int     @id @default(autoincrement())
  perfilId   Int     @default(1)
  classe     String
  percentual Decimal @db.Decimal(5, 2)

  @@index([perfilId])
}

// Parte de um lançamento que outra pessoa deve a você.
model Divisao {
  id          Int       @id @default(autoincrement())
  perfilId    Int       @default(1)
  transacaoId Int
  pessoa      String
  valor       Decimal   @db.Decimal(14, 2)
  quitadoEm   DateTime?
  criadoEm    DateTime  @default(now())

  @@index([perfilId])
  @@index([transacaoId])
}

// Desdobramento, grupamento ou bonificação de um ativo: a quantidade em mãos é multiplicada por `fator` na data
// (desdobramento 1 para 10 = 10; grupamento 10 para 1 = 0.1; bonificação de 10% = 1.1). O custo total não muda.
model EventoAtivo {
  id              Int      @id @default(autoincrement())
  perfilId        Int      @default(1)
  investimentoId  Int
  data            DateTime @db.Date
  tipo            String // DESDOBRAMENTO, GRUPAMENTO ou BONIFICACAO
  fator           Float
  descricao       String?
  chaveImportacao String?
  importacaoId    Int?
  criadoEm        DateTime @default(now())

  @@index([perfilId])
  @@index([investimentoId, data])
}

// Aviso já enviado por e-mail ou Telegram (para não repetir). Fica só neste computador.
model AvisoEnviado {
  id        Int      @id @default(autoincrement())
  perfilId  Int      @default(1)
  chave     String
  enviadoEm DateTime @default(now())

  @@index([perfilId, chave])
}

// Estado do Drive NESTE computador (linha única). Não viaja para a pasta.
model EstadoDrive {
  id             Int       @id @default(1)
  versao         String? // última versão da pasta que este computador carregou ou gravou
  sujo           Boolean   @default(false) // há alteração local ainda não enviada
  alteradoEm     DateTime?
  sincronizadoEm DateTime?
  pendencia      String? // "ESCOLHER": a pessoa precisa dizer qual lado vale
  erro           String?
  ultimoConflito String? // "quando|nome da cópia guardada"
}

// Chave de acesso de um assistente de IA (MCP). O banco guarda só o hash; o texto aparece uma vez, ao criar.
model ChaveMcp {
  id          Int       @id @default(autoincrement())
  nome        String
  hash        String    @unique // sha256 da chave
  prefixo     String // começo da chave, só para a pessoa reconhecer
  permissao   String    @default("LEITURA") // LEITURA ou ESCRITA
  perfilId    Int       @default(1) // perfil financeiro que a chave enxerga
  criadoEm    DateTime  @default(now())
  ultimoUsoEm DateTime?
  usos        Int       @default(0)

  @@index([perfilId])
}

// ===== Configurações da plataforma (linha única, id = 1) =====

model ConfiguracaoPlataforma {
  id            Int     @id @default(1)
  nome          String  @default("Finanças Pessoais")
  slogan        String  @default("Contas, faturas e investimentos em um só lugar.")
  logo          String? // data URL (jpeg, png ou webp) ou endereço http(s); null = logo padrão
  corPrimaria   String  @default("#2563eb")
  corSecundaria String  @default("#1d4ed8")
  enderecoSite  String? // endereço público do site, usado nos links dos e-mails

  smtpServidor       String?
  smtpPorta          Int     @default(587)
  smtpSeguro         Boolean @default(false) // true = TLS direto (porta 465)
  smtpUsuario        String?
  smtpSenhaCifrada   String? // AES-256-GCM; nunca sai pela API
  emailRemetente     String?
  emailNomeRemetente String?
  emailAtivo         Boolean @default(false)

  emailRecuperacao Boolean @default(true)
  emailBoasVindas  Boolean @default(true)

  // Open Finance (Pluggy). Se vazios, valem PLUGGY_CLIENT_ID e PLUGGY_CLIENT_SECRET do .env.
  pluggyClientId            String?
  pluggyClientSecretCifrado String? // AES-256-GCM; nunca sai pela API
  pluggySandbox             Boolean @default(false) // mostra os bancos de teste da Pluggy

  // Cotações (brapi.dev). Se vazio, vale BRAPI_TOKEN do .env.
  brapiTokenCifrado     String? // AES-256-GCM; nunca sai pela API
  // Leitura de cupom por foto (API da Claude) e avisos fora do sistema.
  anthropicChaveCifrada String?
  anthropicModelo       String?
  telegramTokenCifrado  String?
  telegramChatId        String?
  avisosEmail           String? // e-mail que recebe os avisos
  avisosAtivos          Boolean @default(false)

  atualizadoEm DateTime @updatedAt
}

enum TipoTokenSenha {
  RECUPERACAO
  BOAS_VINDAS
}

// Token de uso único para criar ou redefinir a senha por e-mail (só o hash fica no banco).
model TokenSenha {
  id        Int            @id @default(autoincrement())
  usuarioId Int
  tokenHash String         @unique
  tipo      TipoTokenSenha
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime       @default(now())

  @@index([usuarioId])
}

enum StatusEmail {
  ENVIADO
  FALHOU
}

// Histórico dos e-mails enviados (sem o corpo), para o titular conferir.
model EmailEnviado {
  id       Int         @id @default(autoincrement())
  para     String
  assunto  String
  tipo     String // TESTE, RECUPERACAO, BOAS_VINDAS
  status   StatusEmail
  erro     String?
  criadoEm DateTime    @default(now())

  @@index([criadoEm])
}
