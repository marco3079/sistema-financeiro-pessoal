# Os valores abaixo são exemplos.
# O instalador (instalar.ps1 ou instalar.sh) cria o .env com segredos aleatórios.
# Se copiar este arquivo para .env na mão, troque POSTGRES_PASSWORD e JWT_SECRET.

# Senha do banco PostgreSQL
POSTGRES_PASSWORD=financas
# Segredo usado para assinar os logins (JWT)
JWT_SECRET=troque-este-segredo-de-exemplo
# Nome da conta do titular criada na primeira subida
ADMIN_NOME=Demo
# E-mail da conta do titular criada na primeira subida
ADMIN_EMAIL=demo@financas.local
# Senha inicial do titular (padrão: demo1234); troque em Meu perfil depois do primeiro acesso
ADMIN_SENHA=demo1234
# Fuso horário do servidor: define o que é "hoje" no painel
TZ=America/Sao_Paulo
# Porta do site no computador
WEB_PORT=8092
# Porta da API no computador
API_PORT=3092
# Porta do banco no computador (publicada só em 127.0.0.1)
DB_PORT=5434

# Cotações de ações, FIIs e ETFs (brapi.dev). Opcional: também dá para informar na tela Importar (fica cifrado no banco).
# Crie o token gratuito em https://brapi.dev
BRAPI_TOKEN=

# Open Finance (Pluggy). Opcional: também dá para informar na tela Conexões (fica cifrado no banco).
# Crie as credenciais em https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# true mostra os bancos de teste da Pluggy (Pluggy Bank: user-ok / password-ok)
PLUGGY_SANDBOX=false

# Endereço para abrir o sistema no celular (botão do QR code): IP deste computador na rede ou um nome .local.
# Vazio: usa o nome do computador (nome.local).
ENDERECO_REDE=

# Drive: pasta sincronizada (Google Drive, OneDrive...) que guarda os dados, para usar em mais de um computador.
# No Windows, rode conectar-drive.ps1 para escolher a pasta. Vazio = desligado.
PASTA_DRIVE=

# Verificação em duas etapas: deixe "true" só para entrar sem o código quando perder o aparelho e os códigos de
# recuperação; depois desative a verificação na tela Segurança e volte para "false".
DESATIVAR_2FA=false

# Endereço HTTPS do sistema, se houver (veja docs/ACESSO-EXTERNO.md). Ex.: https://meu-pc.tailnet.ts.net
URL_PUBLICA=

# Leitura de cupom por foto (opcional; também dá para informar na tela Leitura de cupom).
ANTHROPIC_API_KEY=
